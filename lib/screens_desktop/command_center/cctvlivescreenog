                  if (widget.savedLayouts.isNotEmpty) ...[
                    Divider(color: AppColors.border(context), height: 24),
                    Text('SAVED LAYOUTS (tap to edit)',
                        style: TextStyle(
                            color: AppColors.textMuted(context),
                            fontSize: 10.5,
                            fontWeight: FontWeight.w700,
                            letterSpacing: 0.6)),
                    const SizedBox(height: 8),
                    Wrap(
                      spacing: 8,
                      runSpacing: 8,
                      children: [
                        for (final layout in widget.savedLayouts)
                          InputChip(
                            label: Text(layout.name),
                            selected: _editingId == layout.id,
                            backgroundColor: AppColors.sunken(context),
                            selectedColor: AppColors.accentBlue.withOpacity(0.18),
                            labelStyle: TextStyle(
                              color: _editingId == layout.id
                                  ? AppColors.accentBlue
                                  : AppColors.textMain(context),
                              fontWeight: FontWeight.w600,
                              fontSize: 12,
                            ),
                            shape: RoundedRectangleBorder(
                              borderRadius: BorderRadius.circular(6),
                              side: BorderSide(
                                color: _editingId == layout.id
                                    ? AppColors.accentBlue
                                    : AppColors.border(context),
                              ),
                            ),
                            deleteIconColor: AppColors.textMuted(context),
                            onDeleted: () async {
                              final wasEditing = _editingId == layout.id;
                              await widget.onDelete(layout);
                              if (!mounted) return;
                              if (wasEditing) {
                                _resetToNew();
                              } else {
                                setState(() {});
                              }
                            },
                            onPressed: () => _loadForEditing(layout),
                          ),
                      ],
                    ),
                  ],
                ],
              ),
            ),
          ),
        ),
      ),
    );
  }
}

