  });

  @override
  State<_LayoutEditorDialog> createState() => _LayoutEditorDialogState();
}

class _LayoutEditorDialogState extends State<_LayoutEditorDialog> {
  static const int _defaultColumns = 2;
  static const int _defaultRows = 2;

  late int _columns;
  late int _rows;
  late List<String?> _slots;
  late TextEditingController _nameController;

  String? _editingId;

  @override
  void initState() {
    super.initState();
    _nameController = TextEditingController();
    _editingId = null;
    _columns = _defaultColumns;
    _rows = _defaultRows;
    _slots = List<String?>.filled(_defaultColumns * _defaultRows, null);
  }

  @override
  void dispose() {
    _nameController.dispose();
    super.dispose();
  }

  void _resetToNew() {
    setState(() {
      _editingId = null;
      _columns = _defaultColumns;
      _rows = _defaultRows;
      _slots = List<String?>.filled(_defaultColumns * _defaultRows, null);
      _nameController.text = '';
    });
  }

  void _loadForEditing(CameraLayoutScheme layout) {
    setState(() {
      _editingId = layout.id;
      _columns = layout.columns;
      _rows = layout.rows;
      _slots = List<String?>.from(layout.slotCameraIds);
      _nameController.text = layout.name;
    });
  }

  void _setGridSize(int columns, int rows) {
    setState(() {
      final newSlotCount = columns * rows;
      final resized = List<String?>.filled(newSlotCount, null);
      for (var i = 0; i < _slots.length && i < newSlotCount; i++) {
        resized[i] = _slots[i];
      }
      _columns = columns;
      _rows = rows;
      _slots = resized;
    });
  }

  Future<void> _assignSlot(int index) async {
    final chosenId = await showModalBottomSheet<String?>(
      context: context,
      backgroundColor: AppColors.card(context),
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(16)),
      ),
      builder: (_) => _CameraPickerSheet(cameras: widget.allCameras),
    );
    if (chosenId == null) return;
    setState(() {
      if (chosenId.isEmpty) {
        _slots[index] = null;
      } else {
        for (var i = 0; i < _slots.length; i++) {
          if (_slots[i] == chosenId) _slots[i] = null;
        }
        _slots[index] = chosenId;
      }
    });
  }

  void _save() {
    final name = _nameController.text.trim();
    final layout = CameraLayoutScheme(
      id: _editingId ?? DateTime.now().millisecondsSinceEpoch.toString(),
      name: name.isEmpty ? '$_columns x $_rows' : name,
      columns: _columns,
      rows: _rows,
      slotCameraIds: _slots,
      isPreset: false,
    );
    Navigator.of(context).pop(layout);
  }

  @override
  Widget build(BuildContext context) {
    final camerasById = {for (final c in widget.allCameras) c.id: c};
    final mediaQuery = MediaQuery.of(context);

    return Padding(
      padding: EdgeInsets.only(bottom: mediaQuery.viewInsets.bottom),
