        },
        onClose: _closeDetailSheet,
        onFalseDetection: () => _handleFalseDetection(incident),
        onSendRequest: () => _handleSendRequestToPurokLeader(incident, camera),
        onDispatchTaskForce: () => _handleDispatchTaskForce(incident, camera),
      ),
    );
  }
